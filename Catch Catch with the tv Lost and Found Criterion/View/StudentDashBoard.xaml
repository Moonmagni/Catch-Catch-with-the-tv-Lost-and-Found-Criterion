<Window x:Class="Catch_Catch_with_the_tv_Lost_and_Found_Criterion.View.StudentDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Dashboard"
        Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#2C2C3E">

    <Grid>
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <TextBlock Text="STUDENT DASHBOARD"
                       FontSize="26"
                       Foreground="White"
                       FontWeight="Bold"
                       Margin="0,0,0,30"
                       HorizontalAlignment="Center"/>

            <Button Content="View Lost Items"
                    Width="200" Height="45" Margin="10"
                    Background="#4CAF50" Foreground="White"
                    FontSize="15" FontWeight="Bold" BorderThickness="0"
                    Command="{Binding ViewLostItemsCommand}"/>

            <Button Content="File a Claim"
                    Width="200" Height="45" Margin="10"
                    Background="#2196F3" Foreground="White"
                    FontSize="15" FontWeight="Bold" BorderThickness="0"
                    Command="{Binding FileClaimCommand}"/>

            <Button Content="Logout"
                    Width="200" Height="45" Margin="10,20,10,0"
                    Background="#E53935" Foreground="White"
                    FontSize="15" FontWeight="Bold" BorderThickness="0"
                    Command="{Binding LogoutCommand}"/>

        </StackPanel>
    </Grid>

</Window>