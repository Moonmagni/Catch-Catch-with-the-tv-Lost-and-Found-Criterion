<Window x:Class="Catch_Catch_with_the_tv_Lost_and_Found_Criterion.View.StudentLostItems"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Report Lost Item"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <Grid Margin="15">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: FORM -->
        <Border Grid.Column="0"
                Background="#F5F5F5"
                Padding="15"
                CornerRadius="10">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <TextBlock Text="REPORT LOST ITEM"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="Item Name" FontWeight="SemiBold"/>
                    <TextBox Height="35"
                             Margin="0,5,0,15"
                             Padding="8"
                             Text="{Binding NewItem.ItemName,
                                            UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Description" FontWeight="SemiBold"/>
                    <TextBox Height="90"
                             Margin="0,5,0,15"
                             Padding="8"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding NewItem.ItemDescription,
                                            UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Location Lost" FontWeight="SemiBold"/>
                    <TextBox Height="35"
                             Margin="0,5,0,20"
                             Padding="8"
                             Text="{Binding NewItem.LocationFound,
                                            UpdateSourceTrigger=PropertyChanged}"/>

                    <WrapPanel HorizontalAlignment="Center">

                        <Button Content="Add"
                                Width="100" Height="40" Margin="5"
                                Background="#4CAF50" Foreground="White"
                                FontWeight="Bold" BorderThickness="0"
                                Command="{Binding AddCommand}"/>

                        <Button Content="Clear"
                                Width="100" Height="40" Margin="5"
                                Background="#607D8B" Foreground="White"
                                FontWeight="Bold" BorderThickness="0"
                                Command="{Binding ClearCommand}"/>

                        <Button Content="Back"
                                Width="100" Height="40" Margin="5"
                                Background="#9E9E9E" Foreground="White"
                                FontWeight="Bold" BorderThickness="0"
                                Command="{Binding BackCommand}"/>

                    </WrapPanel>

                </StackPanel>

            </ScrollViewer>

        </Border>

        <!-- RIGHT: DATA GRID -->
        <Grid Grid.Column="1" Margin="10,0,0,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="LOST ITEMS REPORT"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <Border Grid.Row="1"
                    BorderBrush="#DDD"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="5"
                    Margin="0,0,0,10">

                <TextBox Height="35"
                         Padding="8"
                         FontSize="14"
                         Text="{Binding FilterText,
                                        UpdateSourceTrigger=PropertyChanged}"/>

            </Border>

            <Border Grid.Row="2"
                    BorderBrush="#DDD"
                    BorderThickness="1"
                    CornerRadius="5">

                <DataGrid ItemsSource="{Binding FilteredItems}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          RowHeight="45"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"          Width="70"  Binding="{Binding LostItemID}"/>
                        <DataGridTextColumn Header="Item Name"   Width="2*"  Binding="{Binding ItemName}"/>
                        <DataGridTextColumn Header="Description" Width="3*"  Binding="{Binding ItemDescription}"/>
                        <DataGridTextColumn Header="Location"    Width="2*"  Binding="{Binding LocationFound}"/>
                        <DataGridTextColumn Header="Date Found"  Width="150" Binding="{Binding DateFound, StringFormat=yyyy-MM-dd}"/>
                    </DataGrid.Columns>

                </DataGrid>

            </Border>

        </Grid>

    </Grid>

</Window>