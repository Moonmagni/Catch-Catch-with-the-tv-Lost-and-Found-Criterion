<Window x:Class="Catch_Catch_with_the_tv_Lost_and_Found_Criterion.View.Claims"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claims Management"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <Grid Margin="10">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: FORM -->
        <Border Grid.Column="0"
                Background="#F5F5F5"
                Padding="15"
                CornerRadius="8">

            <StackPanel>

                <TextBlock Text="CLAIM FORM"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,15"/>

                <TextBlock Text="Claim ID"/>
                <TextBox Text="{Binding SelectedClaim.ClaimID}"
                         IsReadOnly="True"
                         Margin="0,5,0,10"/>

                <TextBlock Text="Lost Item ID"/>
                <TextBox Text="{Binding SelectedClaim.LostItemID}"
                         IsReadOnly="True"
                         Margin="0,5,0,10"/>

                <TextBlock Text="Student ID"/>
                <TextBox Text="{Binding SelectedClaim.StudentID}"
                         IsReadOnly="True"
                         Margin="0,5,0,10"/>

                <TextBlock Text="Status"/>
                <TextBox Text="{Binding SelectedClaim.VerificationStatus}"
                         IsReadOnly="True"
                         Margin="0,5,0,10"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,20,0,0">

                    <Button Content="Approve"
                            Width="80" Margin="3"
                            Background="Green" Foreground="White"
                            Command="{Binding ApproveCommand}"/>

                    <Button Content="Reject"
                            Width="80" Margin="3"
                            Background="Orange" Foreground="White"
                            Command="{Binding RejectCommand}"/>

                    <Button Content="Delete"
                            Width="80" Margin="3"
                            Background="Red" Foreground="White"
                            Command="{Binding DeleteCommand}"/>

                    <Button Content="Back"
                            Width="80" Margin="3"
                            Background="#607D8B" Foreground="White"
                            Command="{Binding BackCommand}"/>

                </StackPanel>

            </StackPanel>

        </Border>

        <!-- RIGHT: DATA GRID -->
        <Grid Grid.Column="1" Margin="10,0,0,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="CLAIMS"
                       FontSize="22"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#DDD"
                    BorderThickness="1"
                    Padding="5"
                    Margin="0,0,0,10">

                <TextBox Height="35"
                         Padding="5"
                         Text="{Binding FilterText,
                                        UpdateSourceTrigger=PropertyChanged}"/>

            </Border>

            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="#DDD"
                    BorderThickness="1">

                <DataGrid ItemsSource="{Binding FilteredClaims}"
                          SelectedItem="{Binding SelectedClaim, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          RowHeight="45"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Claim ID"     Width="80"  Binding="{Binding ClaimID}"/>
                        <DataGridTextColumn Header="Lost Item ID" Width="120" Binding="{Binding LostItemID}"/>
                        <DataGridTextColumn Header="Student ID"   Width="120" Binding="{Binding StudentID}"/>
                        <DataGridTextColumn Header="Status"       Width="*"   Binding="{Binding VerificationStatus}"/>
                    </DataGrid.Columns>

                </DataGrid>

            </Border>

        </Grid>

    </Grid>

</Window>