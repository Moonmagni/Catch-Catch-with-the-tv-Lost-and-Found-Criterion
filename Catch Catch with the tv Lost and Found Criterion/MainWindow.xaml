<Window x:Class="Catch_Catch_with_the_tv_Lost_and_Found_Criterion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Catch Catch Login"
        Height="450"
        Width="800">

    <!-- BACKGROUND IMAGE -->
    <Window.Background>
        <ImageBrush ImageSource="C:\Users\Thomas Vargas\Downloads\ChatGPT Image Apr 28, 2026, 11_08_41 AM.png"
                    Stretch="UniformToFill"
                    Opacity="0.15"/>
    </Window.Background>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

            <TextBlock Text="Catch Catch"
                       FontSize="42"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="with the TV: Lost and Found Criterion"
                       FontSize="16"
                       Foreground="#B0B0C3"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"/>
        </StackPanel>

        <!-- LOGIN CARD -->
        <Border Grid.Row="1"
                Width="360"
                Height="260"
                Background="#CC2A2A40"
                CornerRadius="15"
                Padding="25"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <TextBlock Text="Login"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- USERNAME -->
                <Grid Margin="0,0,0,12">
                    <TextBox x:Name="UsernameBox"
                             Height="38"
                             Padding="10"
                             Background="#1E1E2F"
                             Foreground="White"
                             BorderBrush="#444"
                             BorderThickness="1"/>

                    <TextBlock Text="Username"
                               Foreground="Gray"
                               Margin="15,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=UsernameBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- PASSWORD -->
                <Grid Margin="0,0,0,20">
                    <PasswordBox x:Name="PasswordBox"
                                 Height="38"
                                 Padding="10"
                                 Background="#1E1E2F"
                                 Foreground="White"
                                 BorderBrush="#444"
                                 BorderThickness="1"/>

                    <TextBlock Text="Password"
                               Foreground="Gray"
                               Margin="15,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Password, ElementName=PasswordBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- BUTTON -->
                <Button Content="Sign In"
                        Height="40"
                        Background="#4A90E2"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>