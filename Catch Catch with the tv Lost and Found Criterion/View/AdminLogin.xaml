<Window x:Class="Catch_Catch_with_the_tv_Lost_and_Found_Criterion.View.AdminLogin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login"
        Height="400" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2F">

    <Grid>
        <Border Background="#2C2C3E"
                CornerRadius="15"
                Padding="30"
                Width="350"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <StackPanel>

                <TextBlock Text="CATCH CATCH LOGIN"
                           FontSize="22"
                           Foreground="White"
                           FontWeight="Bold"
                           Margin="0,0,0,20"
                           HorizontalAlignment="Center"/>

                <!-- USERNAME -->
                <TextBlock Text="Username"
                           Foreground="#AAAAAA"
                           FontSize="13"
                           Margin="0,0,0,4"/>

                <TextBox Height="35"
                         Margin="0,0,0,15"
                         Background="#3A3A4F"
                         Foreground="White"
                         BorderThickness="0"
                         Padding="10"
                         Text="{Binding CurrentUser.Username, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- PASSWORD -->
                <TextBlock Text="Password"
                           Foreground="#AAAAAA"
                           FontSize="13"
                           Margin="0,0,0,4"/>

                <PasswordBox x:Name="pb"
                             Height="35"
                             Margin="0,0,0,15"
                             Background="#3A3A4F"
                             Foreground="White"
                             BorderThickness="0"
                             Padding="10"/>

                <Button Content="LOGIN"
                        Height="40"
                        Margin="0,10,0,0"
                        Background="#4CAF50"
                        Foreground="White"
                        FontWeight="Bold"
                        Command="{Binding LoginCommand}"
                        CommandParameter="{Binding ElementName=pb}"/>

            </StackPanel>

        </Border>
    </Grid>

</Window>