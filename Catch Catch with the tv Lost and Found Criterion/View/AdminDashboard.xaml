<Window x:Class="Catch_Catch_with_the_tv_Lost_and_Found_Criterion.View.AdminDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Catch_Catch_with_the_tv_Lost_and_Found_Criterion.ViewModel"
        Title="AdminDashboard"
        Height="450" Width="800"
        Background="#2C2C3E">

    <Grid>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <TextBlock Text="ADMIN DASHBOARD"
                       FontSize="26"
                       Foreground="White"
                       FontWeight="Bold"
                       Margin="0,0,0,30"
                       HorizontalAlignment="Center"/>

            <Button Content="Manage Lost Items"
                    Width="200"
                    Height="40"
                    Margin="10"
                    Background="#4CAF50"
                    Foreground="White"
                    Command="{Binding ManageLostItemsCommand}"/>

            <Button Content="View Claims"
                    Width="200"
                    Height="40"
                    Margin="10"
                    Background="#2196F3"
                    Foreground="White"
                    Command="{Binding ViewClaimsCommand}"/>

            <!-- 🔥 LOGOUT BUTTON -->
            <Button Content="Logout"
                    Width="200"
                    Height="40"
                    Margin="10,20,10,0"
                    Background="#E53935"
                    Foreground="White"
                    Command="{Binding LogoutCommand}"/>

        </StackPanel>

    </Grid>
</Window>