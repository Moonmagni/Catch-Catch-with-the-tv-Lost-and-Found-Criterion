<Window x:Class="Catch_Catch_with_the_tv_Lost_and_Found_Criterion.View.MainDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Catch Catch - Lost and Found"
        Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#2C2C3E">

    <Grid>
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <TextBlock Text="CATCH CATCH"
                       FontSize="32"
                       Foreground="White"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,5"/>

            <TextBlock Text="Lost and Found System"
                       FontSize="16"
                       Foreground="#AAAAAA"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,40"/>

            <Button Content="Student"
                    Width="200"
                    Height="45"
                    Margin="10"
                    Background="#4CAF50"
                    Foreground="White"
                    FontSize="15"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Command="{Binding StudentCommand}"/>

            <Button Content="Admin / Employee"
                    Width="200"
                    Height="45"
                    Margin="10"
                    Background="#2196F3"
                    Foreground="White"
                    FontSize="15"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Command="{Binding AdminCommand}"/>

        </StackPanel>
    </Grid>

</Window>